# ==============================================================================
# TraceID Log Service - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Usage: cp env.example .env
# ==============================================================================

# ==============================================================================
# SPLUNK CONFIGURATION (REQUIRED)
# ==============================================================================

# Splunk API hostname (Adobe Splunk default)
SPLUNK_HOST=splunk-api.or1.adobe.net

# Splunk service account username
SPLUNK_USER=svc-aem-voodoo-splunk

# Splunk password (REQUIRED - no default)
# ⚠️ IMPORTANT: Keep this secret! Never commit to git!
SPLUNK_PASS=your-splunk-password-here

# Splunk API port (default: 443 for HTTPS)
SPLUNK_PORT=443

# HTTP scheme (http or https)
SPLUNK_SCHEME=https


# ==============================================================================
# SERVICE CONFIGURATION (OPTIONAL - has defaults)
# ==============================================================================

# Maximum number of retry attempts for Splunk queries
MAX_RETRIES=3

# Default time range for log searches (in hours)
DEFAULT_TIME_RANGE_HOURS=24

# Maximum allowed time range (7 days = 168 hours)
MAX_TIME_RANGE_HOURS=168

# Default maximum number of log entries to return
DEFAULT_LIMIT=500

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO


# ==============================================================================
# HASHICORP VAULT (OPTIONAL - for production secret management)
# ==============================================================================
# If configured, SPLUNK_PASS will be fetched from Vault instead of env var
# Falls back to SPLUNK_PASS env var if Vault authentication fails

# Vault server address
# VAULT_ADDR=https://vault-amer.adobe.net

# Vault AppRole authentication - Role ID
# VAULT_ROLE_ID=your-role-id-here

# Vault AppRole authentication - Secret ID
# VAULT_SECRET_ID=your-secret-id-here

# Path to secret in Vault (should contain SPLUNK_PASS)
# VAULT_SECRET_PATH=your/secret/path


# ==============================================================================
# DEPLOYMENT NOTES
# ==============================================================================
# 
# Local Development:
# 1. Copy this file: cp env.example .env
# 2. Fill in SPLUNK_PASS with your actual password
# 3. Run: uv run python main.py
#
# Render.com Deployment:
# 1. Environment variables are configured in render.yaml
# 2. Set SPLUNK_PASS as a secret in Render dashboard
# 3. Push to GitHub and connect Render to your repo
#
# AWS/Other Cloud:
# 1. Use secrets manager (AWS Secrets Manager, Azure Key Vault, etc.)
# 2. Or set environment variables in container/instance configuration
# 3. For production, consider using Vault integration
#
# ==============================================================================

